{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true, "noUncheckedIndexedAccess": true,
    "types": ["node"], "skipLibCheck": true
  },
  "include": ["src", "tests", "scripts/*.ts", "vite.config.ts"]
}
